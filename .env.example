# Jellyfin + encrypted SFTP media (rclone)
# --- Required ---------------------------------------------------------------
# Names the project, containers, router, networks and volumes
SERVICE_NAME=jellyfin
DOMAIN=media.example.com

# Pin exact releases
JELLYFIN_TAG=12.2
# Keep in step with your other rclone images
RCLONE_TAG=1.75
DOCKER_CLI_TAG=29.9.0-cli-alpine3.24

# First three octets of the two private /30 networks (.0/30 Jellyfin, .4/30 NFS).
# Must not overlap your LAN or VPN.
SUBNET_PREFIX=192.168.100

# --- SFTP storage (the encrypted media) --------------------------------------
SFTP_HOST=storage.box.local
SFTP_PORT=22
SFTP_USER=
# Folder on the SFTP server that holds the encrypted files
SFTP_PATH=media
#   SFTP_PASS     the OBSCURED password: rclone obscure 'your-password'
SFTP_PASS=
SFTP_SHELL_TYPE=unix

# --- Encryption --------------------------------------------------------------
# OBSCURED values (rclone obscure '...'), identical to the ones used when the
# media was encrypted. Keep an offline copy: without them the media is lost.
RCLONE_CONFIG_SECRET_PASSWORD=
RCLONE_CONFIG_SECRET_PASSWORD2=

# --- rclone cache (inside Docker Desktop's virtual disk) ---------------------
RCLONE_CACHE_MAX_SIZE=5G
RCLONE_CACHE_MAX_AGE=72h
RCLONE_CACHE_MIN_FREE=20G

# --- Access control ----------------------------------------------------------
IPV4_ALLOWLIST=0.0.0.0/0
IPV6_ALLOWLIST=::/0

# --- GPU ---------------------------------------------------------------------
# macOS: Docker Desktop can't pass a GPU to containers — leave as runc.
GPU_RUNTIME=runc
GPU_DEVICES=all
GPU_CAPABILITIES=compute,utility,video

# --- Optional overrides ------------------------------------------------------
TZ=Europe/Athens

JELLYFIN_CPU_LIMIT=2
JELLYFIN_MEMORY_LIMIT=1G
JELLYFIN_MEMORY_RESERVATION=512M
JELLYFIN_PIDS_LIMIT=128

RCLONE_CPU_LIMIT=1
RCLONE_MEMORY_LIMIT=512M
RCLONE_MEMORY_RESERVATION=256M
RCLONE_PIDS_LIMIT=128