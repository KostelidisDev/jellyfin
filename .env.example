# Jellyfin stack — keep this file out of git (chmod 600 .env)

# Required
DOMAIN=media.example.com
# Pin the exact release
JELLYFIN_TAG=12.1

# Media library on a network share (examples):
#   NFS:  type=nfs   o=addr=192.168.1.10,nfsvers=4.1,ro,hard   device=:/export/media
#   CIFS: type=cifs  o=addr=192.168.1.10,username=u,password=p,ro   device=//192.168.1.10/media
MEDIA_MOUNT_TYPE=nfs
MEDIA_MOUNT_O=addr=192.168.1.10,nfsvers=4.1,ro,hard
MEDIA_MOUNT_DEVICE=:/export/media

# Hardware transcoding (optional) — uncomment both lines to enable
# COMPOSE_FILE=docker-compose.yml:docker-compose.hwaccel.yml
# RENDER_GID=993

# Frontend network — pinned so Traefik's address is predictable.
# Must not overlap other Docker networks (Nextcloud uses 172.29.0.0/16).
JELLYFIN_SUBNET=172.30.0.0/16
JELLYFIN_GATEWAY=172.30.0.1

# Access control
IPV4_ALLOWLIST=0.0.0.0/0
IPV6_ALLOWLIST=::/0

# Optional overrides
TZ=Europe/Athens
JELLYFIN_CPU_LIMIT=2
JELLYFIN_MEMORY_LIMIT=2G
JELLYFIN_MEMORY_RESERVATION=512M
JELLYFIN_PIDS_LIMIT=1024